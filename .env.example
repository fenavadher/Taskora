# MongoDB Atlas Connection String (Required for database persistence)
MONGO_URI=

# Standalone Backend Server Port (used when running server/ independently)
PORT=5000

# Frontend Origin for standalone CORS configuration
CLIENT_URL=http://localhost:5173

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
